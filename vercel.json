{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": false,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/",
      "destination": "/landing.html",
      "permanent": false
    },
    {
      "source": "/app",
      "has": [
        { "type": "query", "key": "auth", "value": "signin" }
      ],
      "destination": "/auth.html?mode=signin",
      "permanent": false
    },
    {
      "source": "/app",
      "has": [
        { "type": "query", "key": "auth", "value": "signup" }
      ],
      "destination": "/auth.html?mode=signup",
      "permanent": false
    },
    {
      "source": "/lellee-approved-logo-final.jpg",
      "destination": "/lellee-approved-logo-original.jpg?v=20260906-landing-restore",
      "permanent": false
    },
    {
      "source": "/lellee-approved-logo-locked.png",
      "destination": "/lellee-approved-logo-transparent.svg?v=20260903-system1",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/app",
      "destination": "/index.html"
    },
    {
      "source": "/app/:path*",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/service-worker.js",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" },
        { "key": "Service-Worker-Allowed", "value": "/" }
      ]
    },
    {
      "source": "/sw.js",
